# Локально можно не задавать: поднимется SQLite-файл backend/riza.db
# Для Supabase возьмите URI из Project Settings → Database.
# Формат: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/riza

# Смените перед выкладкой
JWT_SECRET=change-me-in-production

# Демо-аккаунты персонала. На проде поставьте false
SEED_DEMO=true

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
